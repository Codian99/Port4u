# Base URL used by the browser AND Nuxt SSR.
# Keep this relative — Nuxt proxies /api/** to NUXT_BACKEND_URL.
NUXT_PUBLIC_API_BASE=/api/v1

# Internal backend origin used by the Nuxt server-side proxy.
#   Local dev : http://localhost:8000
#   Docker    : http://backend:8000
NUXT_BACKEND_URL=http://localhost:8000

# Public site URL used for SEO / sitemap generation.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
