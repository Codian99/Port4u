# --- Host port mappings ---
NGINX_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379

# --- MySQL ---
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret

# --- Laravel (generated with `php artisan key:generate` inside the container) ---
APP_KEY=

# --- Portfolio profile overrides ---
PORTFOLIO_NAME="John Doe"
PORTFOLIO_TITLE="Full Stack Web Developer"
PORTFOLIO_EMAIL=hello@example.com
